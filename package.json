{
  "name": "n8n-nodes-360dialog",
  "version": "0.1.0",
  "description": "360dialog WhatsApp Messaging API community node for n8n: send text, media and template messages, and trigger workflows on inbound WhatsApp messages",
  "license": "MIT",
  "homepage": "https://github.com/pmartinonales/n8n-nodes-360dialog",
  "keywords": [
    "n8n-community-node-package",
    "360dialog",
    "whatsapp",
    "whatsapp-business-api",
    "messaging"
  ],
  "author": {
    "name": "martinicoding",
    "email": "p.martinonales@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pmartinonales/n8n-nodes-360dialog.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/Dialog360Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Dialog360/Dialog360.node.js",
      "dist/nodes/Dialog360/Dialog360Trigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
